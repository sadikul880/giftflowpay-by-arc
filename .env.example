# The wallet that gets the Admin panel (support inbox, user list, stats). Read by the support API, not by the browser.
# Anyone else who connects sees no admin option, and the API refuses their requests.
ADMIN_WALLET=0x145BcFD0238BB136968Da62B8155d189b178d555

# Address of the deployed GiftFlow contract on Arc Testnet (chain 5042002).
# Vite inlines this at build time, so rebuild after changing it.
VITE_GIFTFLOW_ADDRESS_TESTNET=0xa4b97bda0785ab417d0cce128a9fb9449139ee2c
